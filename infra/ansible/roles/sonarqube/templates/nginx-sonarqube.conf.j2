# Ansible tarafindan yonetilir (roles/sonarqube). Yalnizca 443; 80 dinlenmez.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ sonarqube_hostname }};

    ssl_certificate     {{ sonarqube_cert_dir }}/sonarqube.crt;
    ssl_certificate_key {{ sonarqube_cert_dir }}/sonarqube.key;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size {{ sonarqube_max_upload }};

    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
    }
}
