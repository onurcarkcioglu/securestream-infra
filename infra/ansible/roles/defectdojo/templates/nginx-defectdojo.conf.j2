# Ansible tarafindan yonetilir (roles/defectdojo). Yalnizca 443; 80 dinlenmez.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ defectdojo_hostname }};

    ssl_certificate     {{ defectdojo_cert_dir }}/defectdojo.crt;
    ssl_certificate_key {{ defectdojo_cert_dir }}/defectdojo.key;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size {{ defectdojo_max_upload }};

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
    }
}
