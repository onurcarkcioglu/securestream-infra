# Ansible tarafindan yonetilir (roles/dependency_track). Elle duzenleme.
# Dependency-Track {{ dtrack_version }}: API sunucusu + arayuz + PostgreSQL 16. Imajlar digest ile.
#  - API yalnizca 127.0.0.1:8081, arayuz 127.0.0.1:8082; TLS host nginx'te (443)
#  - veritabani sifresi 0600 env dosyasindan; telemetri kapali
name: dependency-track

services:
  apiserver:
    image: "{{ dtrack_apiserver_image }}"
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    env_file: [apiserver.env]
    environment:
      ALPINE_DATABASE_MODE: external
      ALPINE_DATABASE_URL: jdbc:postgresql://postgres:5432/dtrack
      ALPINE_DATABASE_DRIVER: org.postgresql.Driver
      ALPINE_DATABASE_USERNAME: dtrack
      ALPINE_CORS_ENABLED: "true"
      ALPINE_CORS_ALLOW_ORIGIN: "https://{{ dtrack_hostname }}"
      TELEMETRY_SUBMISSION_ENABLED_DEFAULT: "false"
    deploy:
      resources:
        limits:
          memory: "{{ dtrack_api_memory }}"
    volumes:
      - dtrack_data:/data
    ports:
      - "127.0.0.1:8081:8080"

  frontend:
    image: "{{ dtrack_frontend_image }}"
    restart: unless-stopped
    environment:
      API_BASE_URL: "https://{{ dtrack_hostname }}"
    ports:
      - "127.0.0.1:8082:8080"

  postgres:
    image: "{{ dtrack_postgres_image }}"
    restart: unless-stopped
    env_file: [postgres.env]
    environment:
      PGDATA: /var/lib/postgresql/data
      POSTGRES_DB: dtrack
      POSTGRES_USER: dtrack
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U dtrack -d dtrack"]
      interval: 10s
      timeout: 5s
      retries: 12
    volumes:
      - dtrack_postgres:/var/lib/postgresql/data

volumes:
  dtrack_data: {}
  dtrack_postgres: {}
