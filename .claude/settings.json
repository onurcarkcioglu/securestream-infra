{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(/usr/local/bin/ci-status *)"
    ],
    "deny": [
      "Read(~/.config/securestream/**)",
      "Read(~/.ssh/**)",
      "Read(~/.kube/**)",
      "Read(infra/ansible/secrets/**)",
      "Read(infra/ansible/inventory/group_vars/*/vault.yml)",
      "Read(*.tfstate)",
      "Read(*.tfstate.*)",
      "Read(*.env)",
      "Bash(ansible-vault view *)",
      "Bash(ansible-vault decrypt *)",
      "Bash(ansible-vault edit *)",
      "Bash(vault kv get *)",
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *-f)",
      "Bash(git push *+*)",
      "Bash(terraform destroy *)",
      "Bash(*tf.sh destroy*)",
      "Bash(kubectl get secret*)",
      "Bash(kubectl get secrets*)",
      "Bash(kubectl describe secret*)",
      "Edit(scripts/ci-status.sh)",
      "Write(scripts/ci-status.sh)",
      "Bash(git push * --delete*)",
      "Bash(git push --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push -d *)",
      "Bash(git push * :**)",
      "Bash(git branch -D *)",
      "Read(/etc/securestream/**)",
      "Bash(*admin.kubeconfig*)",
      "Bash(*--kubeconfig*)",
      "Bash(*KUBECONFIG=*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(terraform apply *)",
      "Bash(ansible-playbook *)",
      "Bash(helm upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(vault operator *)",
      "Bash(vault token *)",
      "Bash(vault write *)",
      "Bash(vault policy *)",
      "Bash(ssh *)",
      "Bash(sudo *)",
      "Bash(*tf.sh apply*)",
      "Bash(*claude-kubeconfig.sh*)",
      "Bash(*kubeconfig-lockdown.sh*)"
    ]
  },
  "env": {
    "KUBECONFIG": "/home/ubuntu/.kube/claude-readonly.yaml"
  }
}
